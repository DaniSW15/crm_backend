APP_NAME="Enterprise CRM Backend"
APP_VERSION="0.1.0"
DEBUG=True

# PostgreSQL connection string with asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/crm_db
DB_ECHO=False
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# JWT & Security
SECRET_KEY=super-secret-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

